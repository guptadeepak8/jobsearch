{
  "name": "jobsearch-automation",
  "version": "0.1.0",
  "private": true,
  "description": "Locally operated, resource-efficient automated job application assistant",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm --filter @jobsearch/server run test",
    "dev:server": "pnpm --filter @jobsearch/server run dev",
    "dev:dashboard": "pnpm --filter @jobsearch/dashboard run dev",
    "start": "pnpm --filter @jobsearch/server run start"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "better-sqlite3"
    ]
  },
  "keywords": [
    "job-automation",
    "playwright",
    "fastify",
    "typescript"
  ],
  "author": "",
  "license": "MIT"
}
