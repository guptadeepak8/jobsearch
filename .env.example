# ==============================================================================
# Job Application Automation - Environment Configuration
# ==============================================================================

# Server Network Configuration
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# Browser Configuration
# Set to 'false' to see the browser window (required for human takeover and VNC)
BROWSER_HEADLESS=false
# Path to persistent Chromium profile directory (relative to project root or absolute)
BROWSER_USER_DATA_DIR=./data/browser-profile
# Slow motion delay in milliseconds between Playwright actions (helpful for visual debugging)
BROWSER_SLOW_MO=0
# Default navigation timeout in milliseconds
BROWSER_NAVIGATION_TIMEOUT=30000

# Linux Mint X11 Display (uncomment for production on Linux Mint / i3)
# DISPLAY=:0

# Database Configuration (for Milestone 5)
DATABASE_PATH=./data/jobsearch.db
